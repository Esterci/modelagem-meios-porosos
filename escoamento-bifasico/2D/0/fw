FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      fw;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    inlet1
    {
        type            calculated;
        value           uniform 1;
    }
    inlet2
    {
        type            calculated;
        value           uniform 1;
    }
    inlet3
    {
        type            calculated;
        value           uniform 1;
    }
    output1
    {
        type            calculated;
        value           uniform 1;
    }
    output2
    {
        type            calculated;
        value           uniform 1;
    }
    output3
    {
        type            calculated;
        value           uniform 1;
    }
    up
    {
        type            calculated;
        value           uniform 1;
    }
    down
    {
        type            calculated;
        value           uniform 1;
    }
    emptyWalls
    {
        type            empty;
    }
}


